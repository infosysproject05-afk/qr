# MongoDB Atlas Configuration
# Copy this file to .env and replace placeholders with your actual MongoDB Atlas credentials.
MONGODB_USERNAME="<your_mongodb_username>"
MONGODB_PASSWORD="<your_mongodb_password>"
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-domain>/?retryWrites=true&w=majority&appName=files"
MONGODB_DB_NAME="files"
MONGODB_COLLECTION="credentials"
PORT=3000
